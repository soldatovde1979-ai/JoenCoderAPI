////////////////////////////////////////////////////////////////////////////////
// OpenCoder для 1С 8.2 (платформа 8.2.19 и новее)
//
// Отправка запросов к шлюзу OpenCoder напрямую (без gw-proxy) с подписью
// ed25519-v1. Подпись считает Node-подписант oc-sign-cli.mjs, который читает
// устройственный ключ OpenCoder из cc-web-credentials.json:
//
//   1С  --(тело запроса в файл, запуск node)-->  oc-sign-cli.mjs  --> заголовки + файл тела
//   1С  --(HTTPS + заголовки подписи)-->  https://code.accelstacks.com/gw/v1
//
// Почему подпись вынесена в Node: во встроенном языке 8.2 нет ни битовых
// операций, ни 64-битных целых с переносом (SHA-512 на числах 1С даёт другой
// хеш), а подпись ed25519 требует и того, и другого. Node в контуре уже есть —
// на нём работает gw-proxy.
//
// Требования:
//   - платформа 1С 8.2.19+ (ЗащищенноеСоединениеOpenSSL, HTTPЗапрос с заголовками);
//   - Node.js 18+ на машине, где выполняется 1С (путь задаётся в настройках);
//   - oc-sign-cli.mjs и oc-sign.cjs из этого же каталога;
//   - cc-web-credentials.json пользователя, выполнившего вход в OpenCoder
//     (по умолчанию %LOCALAPPDATA%\OpenCoder\cc-web-credentials.json);
//   - корневой сертификат шлюза в хранилище «Доверенные корневые центры»
//     Windows (как для NODE_EXTRA_CA_CERTS в gw-proxy), иначе TLS-ошибка;
//   - право на запуск процессов (ЗапуститьПриложение).
//
// Контекст выполнения:
//   - работает в толстом и тонком клиенте, а также на сервере и во внешнем
//     соединении; в веб-клиенте ЗапуститьПриложение недоступно — модуль там
//     работать не будет;
//   - на клиенте node запускается под текущим пользователем, и креденшалы
//     OpenCoder берутся из его профиля;
//   - на сервере (клиент-серверный вариант) процесс node запускается под
//     пользователем службы 1С. Профиля с cc-web-credentials.json у него, как
//     правило, нет: задайте ПутьККреденшалам на доступную копию либо
//     вызывайте функцию с клиента.
//
// Пример:
//   Результат = ОтправитьЗапросOpenCoder("Сколько будет 2+2?", "flash");
//   Если Результат.Успех Тогда
//       Сообщить(Результат.ТекстОтвета);
//   Иначе
//       Сообщить("Ошибка: " + Результат.Ошибка);
//   КонецЕсли;
//
// Результат — Структура:
//   Успех        — Булево, код ответа 200;
//   КодСостояния — Число, HTTP-код;
//   ТекстОтвета  — Строка, choices[0].message.content;
//   ТелоОтвета   — Строка, тело ответа целиком (JSON);
//   Ошибка       — Строка, причина отказа (пустая при успехе).
//
// Модуль не зависит от конфигурации: достаточно вставить его текст в общий
// модуль (флаг «Сервер» для вызова с сервера) или в модуль обработки.
////////////////////////////////////////////////////////////////////////////////

// Значения по умолчанию. Можно не править, а передать свою Структуру
// последним параметром ОтправитьЗапросOpenCoder (см. НастройкиOpenCoder).
// ПутьКПодписанту и ПутьКNode обязательно проверьте под свою установку.
Функция НастройкиOpenCoder() Экспорт

	Настройки = Новый Структура();
	Настройки.Вставить("Сервер", "code.accelstacks.com");
	Настройки.Вставить("Порт", 443);
	Настройки.Вставить("ПутьЗапроса", "/gw/v1/chat/completions");
	// Адрес подписи должен совпадать с фактически запрашиваемым URL:
	// шлюз проверяет подпись по методу + путь + query.
	Настройки.Вставить("АдресПодписи", "https://code.accelstacks.com/gw/v1/chat/completions");
	Настройки.Вставить("ПутьКNode", "node");
	Настройки.Вставить("ПутьКПодписанту", "C:\Projects\OpenCoderAPI\ZOO\1c\oc-sign-cli.mjs");
	// Пусто — подписант возьмёт %LOCALAPPDATA%\OpenCoder\cc-web-credentials.json.
	Настройки.Вставить("ПутьККреденшалам", "");
	// Пусто — временный каталог пользователя. Задайте ASCII-путь без пробелов,
	// если временный каталог содержит кириллицу и запуск node не срабатывает.
	Настройки.Вставить("КаталогОбмена", "");
	Настройки.Вставить("Модель", "flash");
	// Секунды. Ответ тяжёлой модели может идти дольше минуты.
	Настройки.Вставить("Таймаут", 180);

	Возврат Настройки;

КонецФункции

// Отправляет текстовый запрос и возвращает ответ модели.
//
// Параметры:
//   ТекстЗапроса    — Строка, текст пользовательского сообщения;
//   Модель          — Строка, "flash" или "pro"; пусто — Модель из настроек;
//   СистемныйПромпт — Строка, системная инструкция (необязательно);
//   Температура     — Число или Неопределено;
//   Настройки       — Структура из НастройкиOpenCoder или Неопределено.
//
// Возвращаемое значение:
//   Структура, см. описание в шапке модуля.
Функция ОтправитьЗапросOpenCoder(ТекстЗапроса, Модель = "", СистемныйПромпт = "", Температура = Неопределено, Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = НастройкиOpenCoder();
	КонецЕсли;
	Если ПустаяСтрока(Модель) Тогда
		Модель = Настройки.Модель;
	КонецЕсли;

	ТелоЗапроса = СформироватьТелоЗапроса(ТекстЗапроса, Модель, СистемныйПромпт, Температура);

	Возврат ОтправитьТелоЗапроса(ТелоЗапроса, Настройки);

КонецФункции

// Отправляет произвольное тело запроса (готовый JSON) в /chat/completions.
// Нужен, когда требуются поля, которых нет в ОтправитьЗапросOpenCoder
// (tools, response_format, несколько сообщений и т.п.).
Функция ОтправитьЗапросOpenCoderJSON(ТелоЗапроса, Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = НастройкиOpenCoder();
	КонецЕсли;

	Возврат ОтправитьТелоЗапроса(ТелоЗапроса, Настройки);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Отправка: подпись через Node, затем HTTPS-запрос
////////////////////////////////////////////////////////////////////////////////

Функция ОтправитьТелоЗапроса(ТелоЗапроса, Настройки)

	Результат = Новый Структура("Успех,КодСостояния,ТекстОтвета,ТелоОтвета,Ошибка");
	Результат.Успех = Ложь;
	Результат.КодСостояния = 0;
	Результат.ТекстОтвета = "";
	Результат.ТелоОтвета = "";
	Результат.Ошибка = "";

	ПутьКNode = СокрЛП(Настройки.ПутьКNode);
	Если ПутьКNode = "" Тогда
		ПутьКNode = "node";
	КонецЕсли;
	ПутьКПодписанту = СокрЛП(Настройки.ПутьКПодписанту);
	Если Не ФайлСуществует(ПутьКПодписанту) Тогда
		Результат.Ошибка = "Не найден подписант OpenCoder: " + ПутьКПодписанту
			+ ". Укажите его путь в настройках (ПутьКПодписанту).";
		Возврат Результат;
	КонецЕсли;

	Каталог = СокрЛП(Настройки.КаталогОбмена);
	Если Каталог = "" Тогда
		Каталог = КаталогВременныхФайлов();
	КонецЕсли;

	// Уникальная пара «вход/выход» на каждый вызов: параллельные запросы
	// не перетирают файлы друг друга.
	Идентификатор = Строка(Новый УникальныйИдентификатор());
	Идентификатор = СтрЗаменить(Идентификатор, "-", "");
	Идентификатор = СтрЗаменить(Идентификатор, "{", "");
	Идентификатор = СтрЗаменить(Идентификатор, "}", "");
	ИмяФайла = "oc_" + Идентификатор;

	ПутьТела = ПутьФайлаОбмена(Каталог, ИмяФайла + ".body");
	ПутьВхода = ПутьФайлаОбмена(Каталог, ИмяФайла + ".in");
	ПутьЗаголовков = ПутьФайлаОбмена(Каталог, ИмяФайла + ".hdr");
	ПутьОтвета = ПутьФайлаОбмена(Каталог, ИмяФайла + ".resp");
	ПутьПодписанногоТела = ПутьЗаголовков + ".body";

	ВременныеФайлы = Новый Массив();
	ВременныеФайлы.Добавить(ПутьТела);
	ВременныеФайлы.Добавить(ПутьВхода);
	ВременныеФайлы.Добавить(ПутьЗаголовков);
	ВременныеФайлы.Добавить(ПутьПодписанногоТела);
	ВременныеФайлы.Добавить(ПутьОтвета);

	// 1. Тело запроса. ЗаписьТекста пишет UTF-8 с BOM, а BOM в начале JSON
	// ломает разбор на шлюзе — BOM срезает подписант (см. oc-sign-cli.mjs).
	Попытка
		Запись = Новый ЗаписьТекста(ПутьТела, КодировкаТекста.UTF8);
		Запись.Записать(ТелоЗапроса);
		Запись.Закрыть();
	Исключение
		Результат.Ошибка = "Не удалось записать тело запроса в " + ПутьТела + ": " + ОписаниеОшибки();
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецПопытки;

	// 2. Задание подписанту: метод, адрес подписи, файл тела, путь к креденшалам.
	ТекстВхода = "method" + Символы.Таб + "POST" + Символы.ПС
		+ "url" + Символы.Таб + Настройки.АдресПодписи + Символы.ПС
		+ "bodyfile" + Символы.Таб + ПутьТела + Символы.ПС;
	Если Не ПустаяСтрока(Настройки.ПутьККреденшалам) Тогда
		ТекстВхода = ТекстВхода + "cred" + Символы.Таб + Настройки.ПутьККреденшалам + Символы.ПС;
	КонецЕсли;

	Попытка
		Запись = Новый ЗаписьТекста(ПутьВхода, КодировкаТекста.UTF8);
		Запись.Записать(ТекстВхода);
		Запись.Закрыть();
	Исключение
		Результат.Ошибка = "Не удалось записать задание подписанту в " + ПутьВхода + ": " + ОписаниеОшибки();
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецПопытки;

	// 3. Подпись. В командную строку попадают только пути — текст запроса в ней не светится.
	Команда = ОбернутьВКавычки(ПутьКNode) + " " + ОбернутьВКавычки(ПутьКПодписанту)
		+ " " + ОбернутьВКавычки(ПутьВхода) + " " + ОбернутьВКавычки(ПутьЗаголовков);
	Попытка
		ЗапуститьПриложение(Команда, Каталог, Истина);
	Исключение
		Результат.Ошибка = "Не удалось запустить подписант (" + Команда + "): " + ОписаниеОшибки();
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецПопытки;

	// 4. Разбор результата подписанта.
	Если Не ФайлСуществует(ПутьЗаголовков) Тогда
		Результат.Ошибка = "Подписант не создал файл заголовков " + ПутьЗаголовков
			+ ". Проверьте, что node доступен и oc-sign.cjs лежит рядом с oc-sign-cli.mjs.";
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(ПутьЗаголовков, КодировкаТекста.UTF8);
		ТекстЗаголовков = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Результат.Ошибка = "Не удалось прочитать заголовки подписи: " + ОписаниеОшибки();
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецПопытки;

	Заголовки = Новый Соответствие();
	ОшибкаПодписи = "";
	ПутьПодписанногоТела = "";
	ТекстЗаголовков = СтрЗаменить(ТекстЗаголовков, Символы.ВК, "");
	Для НомерСтроки = 1 По СтрЧислоСтрок(ТекстЗаголовков) Цикл
		ТекущаяСтрока = СтрПолучитьСтроку(ТекстЗаголовков, НомерСтроки);
		ПозицияТабуляции = Найти(ТекущаяСтрока, Символы.Таб);
		Если ПозицияТабуляции = 0 Тогда
			Продолжить;
		КонецЕсли;
		ВидЗаписи = Лев(ТекущаяСтрока, ПозицияТабуляции - 1);
		ОстатокСтроки = Сред(ТекущаяСтрока, ПозицияТабуляции + 1);
		Если ВидЗаписи = "error" Тогда
			ОшибкаПодписи = ОстатокСтроки;
		ИначеЕсли ВидЗаписи = "bodyfile" Тогда
			// Файл тела, байты которого подписаны. Отправлять нужно именно его:
			// BOM уже срезан, тело и подпись гарантированно совпадают.
			ПутьПодписанногоТела = ОстатокСтроки;
		ИначеЕсли ВидЗаписи = "header" Тогда
			ПозицияТабуляции = Найти(ОстатокСтроки, Символы.Таб);
			Если ПозицияТабуляции = 0 Тогда
				Продолжить;
			КонецЕсли;
			Заголовки.Вставить(Лев(ОстатокСтроки, ПозицияТабуляции - 1), Сред(ОстатокСтроки, ПозицияТабуляции + 1));
		КонецЕсли;
	КонецЦикла;

	Если Не ПустаяСтрока(ОшибкаПодписи) Тогда
		Результат.Ошибка = "Подписант: " + ОшибкаПодписи;
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецЕсли;
	Если Заголовки.Получить("x-ccw-request-signature") = Неопределено Тогда
		Результат.Ошибка = "Подписант не вернул заголовок x-ccw-request-signature. Файл: " + ПутьЗаголовков;
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецЕсли;
	Если ПутьПодписанногоТела = "" ИЛИ Не ФайлСуществует(ПутьПодписанногоТела) Тогда
		Результат.Ошибка = "Подписант не указал файл подписанного тела (" + ПутьПодписанногоТела + ").";
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецЕсли;

	Заголовки.Вставить("content-type", "application/json; charset=utf-8");
	Заголовки.Вставить("accept", "application/json");

	// 5. Запрос к шлюзу. Тело берётся из того же файла, что подписан.
	Попытка
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение(Настройки.Сервер, Настройки.Порт, "", "", Неопределено, Настройки.Таймаут, ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(Настройки.ПутьЗапроса, Заголовки);
		Запрос.УстановитьТело(Новый ДвоичныеДанные(ПутьПодписанногоТела));
		Ответ = Соединение.Вызвать(Запрос, ПутьОтвета);
		Результат.КодСостояния = Ответ.КодСостояния;
	Исключение
		Результат.Ошибка = "HTTP-запрос к " + Настройки.Сервер + " не выполнен: " + ОписаниеОшибки();
		УдалитьФайлыОбмена(ВременныеФайлы);
		Возврат Результат;
	КонецПопытки;

	Если ФайлСуществует(ПутьОтвета) Тогда
		Попытка
			Чтение = Новый ЧтениеТекста(ПутьОтвета, КодировкаТекста.UTF8);
			Результат.ТелоОтвета = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			Результат.Ошибка = "Не удалось прочитать ответ шлюза: " + ОписаниеОшибки();
			УдалитьФайлыОбмена(ВременныеФайлы);
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;

	Если Результат.КодСостояния = 200 Тогда
		Результат.Успех = Истина;
		Результат.ТекстОтвета = ИзвлечьТекстОтвета(Результат.ТелоОтвета);
	Иначе
		Результат.Ошибка = "Шлюз вернул HTTP " + Строка(Результат.КодСостояния) + ": " + ИзвлечьТекстОшибки(Результат.ТелоОтвета);
	КонецЕсли;

	УдалитьФайлыОбмена(ВременныеФайлы);

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Сборка и разбор JSON (в 8.2 нет ЧтениеJSON/ЗаписьJSON — они с 8.3.6)
////////////////////////////////////////////////////////////////////////////////

Функция СформироватьТелоЗапроса(ТекстЗапроса, Модель, СистемныйПромпт, Температура)

	Сообщения = "";
	Если Не ПустаяСтрока(СистемныйПромпт) Тогда
		Сообщения = "{""role"":""system"",""content"":""" + ЭкранироватьJSONСтроку(СистемныйПромпт) + """}";
	КонецЕсли;
	Если Не ПустаяСтрока(Сообщения) Тогда
		Сообщения = Сообщения + ",";
	КонецЕсли;
	Сообщения = Сообщения + "{""role"":""user"",""content"":""" + ЭкранироватьJSONСтроку(ТекстЗапроса) + """}";

	ТелоЗапроса = "{""model"":""" + ЭкранироватьJSONСтроку(Модель)
		+ """,""stream"":false,""messages"":[" + Сообщения + "]";

	Если Температура <> Неопределено Тогда
		ТелоЗапроса = ТелоЗапроса + ",""temperature"":" + ЧислоВJSON(Температура);
	КонецЕсли;

	Возврат ТелоЗапроса + "}";

КонецФункции

Функция ЭкранироватьJSONСтроку(Значение)

	ОбратнаяКосая = "\";
	Кавычка = """";
	Текст = Строка(Значение);

	// Порядок важен: сначала экранируется сама обратная косая, иначе
	// экранированные кавычки получат двойную косую.
	Текст = СтрЗаменить(Текст, ОбратнаяКосая, ОбратнаяКосая + ОбратнаяКосая);
	Текст = СтрЗаменить(Текст, Кавычка, ОбратнаяКосая + Кавычка);
	Текст = СтрЗаменить(Текст, Символы.ПС, ОбратнаяКосая + "n");
	Текст = СтрЗаменить(Текст, Символы.ВК, ОбратнаяКосая + "r");
	Текст = СтрЗаменить(Текст, Символы.Таб, ОбратнаяКосая + "t");

	Возврат Текст;

КонецФункции

// Строка(Число) в 1С зависит от локали: убираем разделитель групп и меняем запятую на точку.
Функция ЧислоВJSON(Значение)

	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, ",", ".");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	Текст = СтрЗаменить(Текст, Символы.Таб, "");

	Возврат Текст;

КонецФункции

// Возвращает choices[0].message.content. Разбор упрощённый: если структура
// ответа шлюза изменится, полный JSON остаётся в ТелоОтвета.
Функция ИзвлечьТекстОтвета(ТелоОтвета)

	Позиция = НайтиСПозиции(ТелоОтвета, """choices""", 1);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Позиция = НайтиСПозиции(ТелоОтвета, """message""", Позиция);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Значение = НайтиПолеJSON(ТелоОтвета, "content", Позиция);
	Если Значение = Неопределено Тогда
		Возврат ""; // content: null — модель вернула только tool_calls
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Возвращает error.message, а если ответ не JSON — начало тела.
Функция ИзвлечьТекстОшибки(ТелоОтвета)

	Если ПустаяСтрока(ТелоОтвета) Тогда
		Возврат "пустой ответ";
	КонецЕсли;

	Позиция = НайтиСПозиции(ТелоОтвета, """error""", 1);
	Если Позиция > 0 Тогда
		Сообщение = НайтиПолеJSON(ТелоОтвета, "message", Позиция);
		Если Сообщение <> Неопределено Тогда
			Возврат Сообщение;
		КонецЕсли;
	КонецЕсли;

	Если СтрДлина(ТелоОтвета) > 500 Тогда
		Возврат Лев(ТелоОтвета, 500) + "...";
	КонецЕсли;

	Возврат ТелоОтвета;

КонецФункции

// Находит строковое поле ИмяПоля после позиции НачинаяС.
// Возвращает Неопределено, если поля нет или его значение не строка.
Функция НайтиПолеJSON(Текст, ИмяПоля, НачинаяС = 1)

	Метка = """" + ИмяПоля + """";
	Позиция = НайтиСПозиции(Текст, Метка, НачинаяС);
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Позиция = Позиция + СтрДлина(Метка);

	Пока Позиция <= СтрДлина(Текст) И ЭтоПробельныйСимвол(Сред(Текст, Позиция, 1)) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Позиция > СтрДлина(Текст) ИЛИ Сред(Текст, Позиция, 1) <> ":" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Позиция = Позиция + 1;

	Пока Позиция <= СтрДлина(Текст) И ЭтоПробельныйСимвол(Сред(Текст, Позиция, 1)) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Позиция > СтрДлина(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Сред(Текст, Позиция, 1) = """" Тогда
		Возврат ИзвлечьСтрокуJSON(Текст, Позиция);
	КонецЕсли;

	// Числа, true/false, null и вложенные объекты вызывающему коду не нужны.
	Возврат Неопределено;

КонецФункции

// Распаковывает строку JSON, начиная с открывающей кавычки в позиции Позиция.
Функция ИзвлечьСтрокуJSON(Текст, Позиция)

	Результат = "";
	ОбратнаяКосая = "\";
	Длина = СтрДлина(Текст);
	Позиция = Позиция + 1; // за открывающую кавычку

	Пока Позиция <= Длина Цикл
		ТекСимвол = Сред(Текст, Позиция, 1);
		Если ТекСимвол = """" Тогда
			Возврат Результат;
		ИначеЕсли ТекСимвол = ОбратнаяКосая Тогда
			Позиция = Позиция + 1;
			Код = Сред(Текст, Позиция, 1);
			Если Код = "n" Тогда
				Результат = Результат + Символы.ПС;
			ИначеЕсли Код = "r" Тогда
				Результат = Результат + Символы.ВК;
			ИначеЕсли Код = "t" Тогда
				Результат = Результат + Символы.Таб;
			ИначеЕсли Код = "b" Тогда
				Результат = Результат + Символ(8);
			ИначеЕсли Код = "f" Тогда
				Результат = Результат + Символ(12);
			ИначеЕсли Код = "u" Тогда
				КодЮникода = ШестнадцатеричноеВЧисло(Сред(Текст, Позиция + 1, 4));
				Позиция = Позиция + 4;
				Попытка
					Результат = Результат + Символ(КодЮникода);
				Исключение
					// Суррогатная пара или недопустимый код — символ пропускаем.
				КонецПопытки;
			Иначе
				Результат = Результат + Код; // \" \\ \/ и любые прочие
			КонецЕсли;
		Иначе
			Результат = Результат + ТекСимвол;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиСПозиции(Текст, Подстрока, НачинаяС)

	Если НачинаяС < 1 Тогда
		НачинаяС = 1;
	КонецЕсли;
	Если НачинаяС > СтрДлина(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Позиция = Найти(Сред(Текст, НачинаяС), Подстрока);
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат НачинаяС + Позиция - 1;

КонецФункции

Функция ЭтоПробельныйСимвол(ТекСимвол)

	Возврат ТекСимвол = " " ИЛИ ТекСимвол = Символы.Таб ИЛИ ТекСимвол = Символы.ПС ИЛИ ТекСимвол = Символы.ВК;

КонецФункции

Функция ШестнадцатеричноеВЧисло(ТекстHex)

	Цифры = "0123456789abcdef";
	Результат = 0;

	Для НомерСимвола = 1 По СтрДлина(ТекстHex) Цикл
		Позиция = Найти(Цифры, НРег(Сред(ТекстHex, НомерСимвола, 1)));
		Если Позиция = 0 Тогда
			Продолжить; // не hex-цифра — пропускаем
		КонецЕсли;
		Результат = Результат * 16 + (Позиция - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Служебное
////////////////////////////////////////////////////////////////////////////////

Функция ПутьФайлаОбмена(Каталог, ИмяФайла)

	ПоследнийСимвол = "";
	Если СтрДлина(Каталог) > 0 Тогда
		ПоследнийСимвол = Прав(Каталог, 1);
	КонецЕсли;
	Если ПоследнийСимвол = "\" ИЛИ ПоследнийСимвол = "/" Тогда
		Возврат Каталог + ИмяФайла;
	КонецЕсли;

	Возврат Каталог + "\" + ИмяФайла;

КонецФункции

Функция ОбернутьВКавычки(Значение)

	Возврат """" + Значение + """";

КонецФункции

Процедура УдалитьФайлыОбмена(Пути)

	Для Каждого ПутьФайла Из Пути Цикл
		Попытка
			Если ФайлСуществует(ПутьФайла) Тогда
				УдалитьФайлы(ПутьФайла);
			КонецЕсли;
		Исключение
			// Не критично: файл остался во временном каталоге.
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры
